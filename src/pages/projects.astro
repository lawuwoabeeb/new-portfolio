---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ProjectCard from '@components/ProjectCard.astro';
import NewsletterForm from '@components/NewsletterForm.astro';
import { projectsData } from '@data/projects';

// Extract unique categories for filter UI readiness
const categories = ["All", ...new Set(projectsData.map((p) => p.category))];
---

<BaseLayout
  title="Projects — Abeeb Olawuwo"
  description="Explore Abeeb Olawuwo's projects, workflow tools, parametric estimators, and digital technology concepts for civil engineering and construction."
>
  <!-- Projects Hero -->
  <section class="projects-hero-section">
    <div class="container">
      <div class="tag-row">
        <span class="badge badge-accent">PORTFOLIO &amp; WORKFLOW CONCEPTS</span>
      </div>
      <h1 class="projects-title">
        SELECTED <span class="text-accent">PROJECTS</span> &amp; EXPERIMENTS.
      </h1>
      <p class="projects-lead">
        A curated archive of digital workflow concepts, parametric structural tools, site logistics models, and product explorations aimed at upgrading modern construction practices.
      </p>
    </div>
  </section>

  <!-- Projects Listing & Filter UI -->
  <section class="section section-border">
    <div class="container">
      <!-- Category Filter Bar (Structured for filtering readiness) -->
      <div class="filter-bar" aria-label="Filter Projects by Category">
        <span class="filter-label">DISCIPLINE:</span>
        <div class="filter-options" id="filter-options">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class:list={["filter-btn", { active: idx === 0 }]}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Project Cards Grid -->
      <div class="projects-grid-full" id="projects-grid">
        {projectsData.map((project) => (
          <div class="project-item-wrapper" data-category={project.category}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="section section-border bg-subtle">
    <div class="container">
      <NewsletterForm
        headline="NEVER MISS A DIGITAL WORKFLOW EXPLORATION"
        subheadline="Subscribe to receive weekly insights, structural workflow concepts, and practical tools sent directly to your inbox."
      />
    </div>
  </section>
</BaseLayout>

<script>
  // Simple client-side category filter script
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const projectItems = document.querySelectorAll<HTMLDivElement>('.project-item-wrapper');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedCategory = btn.getAttribute('data-category');

        // Toggle active button class
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter project items with smooth display transition
        projectItems.forEach((item) => {
          const itemCategory = item.getAttribute('data-category');
          if (selectedCategory === 'All' || itemCategory === selectedCategory) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .projects-hero-section {
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .tag-row {
    margin-bottom: 1.5rem;
  }

  .projects-title {
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    line-height: 1.02;
    max-width: 960px;
    margin-bottom: 2rem;
  }

  .text-accent {
    color: var(--color-accent);
  }

  .projects-lead {
    font-size: clamp(1.2rem, 2.2vw, 1.4rem);
    color: var(--color-text-muted);
    max-width: 780px;
    line-height: 1.6;
  }

  /* Filter Bar */
  .filter-bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .filter-label {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .filter-options {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: none;
    border: 1px solid var(--color-border);
    padding: 0.5rem 1.1rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--color-text);
  }

  .filter-btn.active {
    background-color: var(--color-text);
    color: #ffffff;
    border-color: var(--color-text);
  }

  /* Grid Layout */
  .projects-grid-full {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 2.5rem;
  }

  .bg-subtle {
    background-color: var(--color-bg-subtle);
  }

  @media (max-width: 640px) {
    .projects-grid-full {
      grid-template-columns: 1fr;
    }
    .filter-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
