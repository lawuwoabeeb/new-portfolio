---
import type { Project } from '@data/projects';

interface Props {
  project: Project;
  layout?: 'grid' | 'featured';
}

const { project, layout = 'grid' } = Astro.props;
---

<article class:list={["project-card", `layout-${layout}`]}>
  <div class="card-image-wrapper">
    <img
      src={project.image}
      alt={`Thumbnail illustration for ${project.title}`}
      class="card-image"
      loading="lazy"
      width="800"
      height="500"
    />
    <div class="card-category-overlay">
      <span class="badge badge-accent">{project.category}</span>
      <span class="project-year">{project.year}</span>
    </div>
  </div>

  <div class="card-body">
    <div class="tags-container">
      {project.tags.map((tag) => (
        <span class="tag-pill">{tag}</span>
      ))}
    </div>

    <h3 class="card-title">
      <a href="/projects" class="title-link">{project.title}</a>
    </h3>

    <p class="card-description">{project.shortDescription}</p>

    <div class="card-footer">
      <a href="/projects" class="card-action-link" aria-label={`View details for ${project.title}`}>
        <span>{project.linkText || 'Explore Concept'}</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3.33334 8H12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 3.33334L12.6667 8L8 12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .project-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition-medium), border-color var(--transition-medium), box-shadow var(--transition-medium);
  }

  .project-card:hover {
    border-color: var(--color-border-dark);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.06);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: #111111;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-medium);
  }

  .project-card:hover .card-image {
    transform: scale(1.03);
  }

  .card-category-overlay {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .project-year {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: #ffffff;
    background-color: rgba(17, 17, 17, 0.85);
    padding: 0.25rem 0.6rem;
    backdrop-filter: blur(4px);
  }

  .card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .tag-pill {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    padding: 0.2rem 0.5rem;
    border: 1px solid #eaeaea;
  }

  .card-title {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.15;
  }

  .title-link {
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  .card-description {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
    flex: 1;
  }

  .card-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .card-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color var(--transition-fast), gap var(--transition-fast);
  }

  .project-card:hover .card-action-link {
    color: var(--color-accent);
    gap: 0.75rem;
  }

  /* Featured layout variant */
  .layout-featured {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
  }

  .layout-featured .card-image-wrapper {
    height: 100%;
    aspect-ratio: auto;
  }

  @media (max-width: 850px) {
    .layout-featured {
      grid-template-columns: 1fr;
    }
  }
</style>
