---
interface Props {
  tag?: string;
  title: string;
  subtitle?: string;
  alignment?: 'left' | 'center';
}

const { tag, title, subtitle, alignment = 'left' } = Astro.props;
---

<div class:list={["section-heading", `align-${alignment}`]}>
  {tag && <div class="tag-label">{tag}</div>}
  <h2 class="title">{title}</h2>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .align-center {
    text-align: center;
  }

  .align-center .subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .tag-label {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    position: relative;
    padding-left: 1rem;
  }

  .tag-label::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    background-color: var(--color-accent);
  }

  .title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin-top: 0.75rem;
    max-width: 650px;
  }
</style>
