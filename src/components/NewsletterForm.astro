---
interface Props {
  headline?: string;
  subheadline?: string;
  compact?: boolean;
}

const {
  headline = "THE DIGITAL CONSTRUCTION WEEKLY",
  subheadline = "Practical insights on how digital tools, software workflows, and product design are upgrading construction practices and field productivity.",
  compact = false
} = Astro.props;
---

<section id="newsletter" class:list={["newsletter-section", { "compact": compact }]}>
  <div class="newsletter-card">
    <div class="newsletter-content">
      <div class="tag-row">
        <span class="badge badge-accent">WEEKLY NEWSLETTER</span>
      </div>
      <h2 class="newsletter-headline">{headline}</h2>
      <p class="newsletter-subheadline">{subheadline}</p>

      <form class="newsletter-form" id="newsletter-form" novalidate>
        <div class="input-group">
          <label for="newsletter-email" class="visually-hidden">Email address</label>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            class="newsletter-input"
            placeholder="Enter your email (e.g. alex@construction.com)"
            required
            aria-describedby="newsletter-status-message"
          />
          <button type="submit" class="btn btn-accent newsletter-submit">
            <span>Subscribe</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M3.33334 8H12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8 3.33334L12.6667 8L8 12.6667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        <div id="newsletter-status-message" class="status-message" aria-live="polite"></div>

        <p class="newsletter-disclaimer">
          No spam. Unsubscribe anytime. Registration system coming soon.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  // Frontend-only email validation and feedback state handler
  document.addEventListener('DOMContentLoaded', () => {
    const forms = document.querySelectorAll<HTMLFormElement>('#newsletter-form');

    forms.forEach((form) => {
      const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
      const statusMsg = form.querySelector<HTMLDivElement>('.status-message');

      if (!emailInput || !statusMsg) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const emailValue = emailInput.value.trim();

        // Clear previous state
        statusMsg.className = 'status-message';
        statusMsg.textContent = '';

        // Standard email regex format validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!emailValue) {
          statusMsg.classList.add('error');
          statusMsg.textContent = 'Please enter your email address.';
          emailInput.focus();
          return;
        }

        if (!emailRegex.test(emailValue)) {
          statusMsg.classList.add('error');
          statusMsg.textContent = 'Please enter a valid email address (e.g. name@domain.com).';
          emailInput.focus();
          return;
        }

        // Valid email format entered: Display clear status that backend newsletter integration is coming soon
        statusMsg.classList.add('info');
        statusMsg.textContent = 'Thank you for your interest! Weekly newsletter registration will be available soon as backend integration is connected.';
        
        // Reset input without storing data anywhere
        emailInput.value = '';
      });
    });
  });
</script>

<style>
  .newsletter-section {
    width: 100%;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .newsletter-card {
    background-color: var(--color-bg-subtle);
    border: 2px solid var(--color-text);
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 3.5rem);
    position: relative;
    overflow: hidden;
  }

  .newsletter-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 100%;
    background-color: var(--color-accent);
  }

  .newsletter-content {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .tag-row {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .newsletter-headline {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .newsletter-subheadline {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    margin-bottom: 2.5rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .newsletter-form {
    max-width: 600px;
    margin: 0 auto;
  }

  .input-group {
    display: flex;
    gap: 0.5rem;
    position: relative;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .newsletter-input {
    flex: 1;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 1rem 1.25rem;
    border: 1.5px solid var(--color-border-dark);
    background-color: #ffffff;
    color: var(--color-text);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .newsletter-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .newsletter-submit {
    white-space: nowrap;
    padding: 1rem 1.75rem;
  }

  .status-message {
    margin-top: 1rem;
    font-size: 0.95rem;
    font-weight: 500;
    min-height: 1.5rem;
    text-align: left;
    transition: all var(--transition-fast);
  }

  .status-message.error {
    color: #D32F2F;
    background-color: #FFEBEE;
    padding: 0.6rem 1rem;
    border-left: 3px solid #D32F2F;
  }

  .status-message.info {
    color: #0E6251;
    background-color: #E8F8F5;
    padding: 0.8rem 1rem;
    border-left: 3px solid #117A65;
  }

  .newsletter-disclaimer {
    font-size: 0.85rem;
    color: #777777;
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .input-group {
      flex-direction: column;
    }
    .newsletter-submit {
      width: 100%;
    }
  }
</style>
